# Copia este archivo como «.env» y rellena lo que necesites.
# El archivo .env NO se sube a GitHub (está en .gitignore). Nunca pongas claves en el código.

# --- Básico ---
PORT=3000
# Dirección pública de la web (se usa en los enlaces de invitado y en los pagos)
BASE_URL=http://localhost:3000
# Contraseña de la cuenta «admin» la primera vez (si no, se genera una y se muestra en la consola)
ADMIN_PASSWORD=
# Pon 1 solo para demostraciones: crea las cuentas docente, vip y pago con contraseñas conocidas
DEMO=0
# 1 si el servidor está detrás de un proxy (Render, Railway, Nginx…)
TRUST_PROXY=1

# --- Invitados ---
GUEST_DAYS=14
# 1 = cualquiera puede pedir una prueba gratis desde la pantalla de inicio (necesita correo configurado)
GUEST_SELF_SIGNUP=1

# --- Correo (para enviar los enlaces de invitado) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Recursos SAFA <no-responder@tu-centro.es>

# --- Pagos (plan con cursos) ---
PRICE_EUR=49
CURRENCY=eur
PAID_ACCESS_MONTHS=12
# Stripe: claves en https://dashboard.stripe.com/apikeys (empieza con sk_test_ para pruebas)
STRIPE_SECRET_KEY=
# Webhook de Stripe apuntando a BASE_URL/api/pagos/stripe/webhook (evento checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# PayPal: credenciales de una app en https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (pruebas) o live (real)
PAYPAL_ENV=sandbox

# --- Guardado automático en GitHub ---
# Token «fine-grained» con permiso Contents: Read and write SOLO en este repositorio
GITHUB_TOKEN=
GITHUB_REPO=dmanjon-star/plataforma_recursos_educativos_safa
GITHUB_BRANCH=main
SYNC_INTERVAL_HOURS=24

# --- Ficha automática con inteligencia artificial (opcional) ---
# Sin clave, la plataforma clasifica igualmente con sus reglas.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
